# Terraforge Environment Variables
# Cesium ion access token for Google Photorealistic 3D Tiles in Earth Surface Zoom mode.
# Sign up free at https://cesium.com/ion/ and add "Google Photorealistic 3D Tiles" (Asset ID 2275207) to your My Assets.
# When deploying to Vercel, add this token in Project Settings -> Environment Variables,
# and ensure your Vercel deployment domain is added to Cesium ion Token -> Allowed URLs.
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here


VITE_MAPILLARY_TOKEN=your_mapillary_client_token_here
